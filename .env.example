# Copy to .env.local for local development. Never commit real values.
# NEXT_PUBLIC_* values are compiled into the browser bundle and are not secret.

# ---------------------------------------------------------------- site
# Canonical base URL for canonicals, Open Graph, sitemap and schema @ids.
# LEAVE EMPTY on Vercel previews: the build then uses that deployment's own URL,
# so share images resolve on the preview (see src/lib/seo.ts).
# Set to https://www.callacornelectric.com on the production launch.
NEXT_PUBLIC_SITE_URL=

# Indexing is OFF until launch. "true" only takes effect when
# NEXT_PUBLIC_SITE_URL is exactly https://www.callacornelectric.com and the
# build is not a Vercel preview. Every host other than www also gets an
# X-Robots-Tag: noindex header (next.config.mjs).
NEXT_PUBLIC_ALLOW_INDEXING=false

# "To confirm" markers on unverified facts. OFF unless exactly "true". Use only
# for a private internal review build; visitors never see them by default.
NEXT_PUBLIC_SHOW_REVIEW_FLAGS=

# ---------------------------------------------------------------- forms (server-only secrets)
# Resend (https://resend.com) delivers form submissions and their attachments
# by email. While the key or sender is empty, the forms tell visitors plainly
# to call instead; nothing is reported as sent when it wasn't.
RESEND_API_KEY=
# Must be on a domain verified in Resend, e.g. a send.callacornelectric.com subdomain.
MAIL_FROM="Acorn Electric website <website@send.callacornelectric.com>"
# Service requests. Defaults to eric@callacornelectric.com (src/lib/site.ts).
# Comma-separate for more than one inbox.
LEADS_TO=
# Job applications. Defaults to LEADS_TO, then eric@callacornelectric.com.
CAREERS_TO=

# ---------------------------------------------------------------- testing (never production)
# "log": build each email (fields + attachments) and log only counts/sizes,
#        sending nothing. "fail": simulate a provider failure.
# Ignored on Vercel production deployments.
MAIL_TRANSPORT=
