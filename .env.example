# Copy to .env.local for local development. Never commit real values.
# NEXT_PUBLIC_* values are compiled into the browser bundle and are not secret.

# ---------------------------------------------------------------- site
# Absolute base URL for canonicals, Open Graph, sitemap and schema @ids.
# On preview deployments set this to the preview URL.
NEXT_PUBLIC_SITE_URL=https://www.callacornelectric.com

# Indexing is OFF until launch. Set "true" ONLY on the production deploy that
# replaces the current site, after redirects are mapped.
NEXT_PUBLIC_ALLOW_INDEXING=false

# "To confirm" markers on unverified facts. Leave on for previews; set "false"
# on production only after every marker is resolved (docs/handoff.md).
NEXT_PUBLIC_SHOW_REVIEW_FLAGS=true

# ---------------------------------------------------------------- forms (server-only secrets)
# Resend (https://resend.com) delivers form submissions by email. While any of
# these are empty, the forms tell visitors plainly to call instead; nothing is
# reported as sent when it wasn't.
RESEND_API_KEY=
# Must be on a domain verified in Resend, e.g. a send.callacornelectric.com subdomain.
MAIL_FROM="Acorn Electric website <website@send.callacornelectric.com>"
# Service inquiries. Comma-separate for more than one inbox.
LEADS_TO=
# Job applications (falls back to LEADS_TO).
CAREERS_TO=
